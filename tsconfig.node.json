{
  "compilerOptions": {
    "target": "ES2022",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "strict": true,
    "allowJs": false,
    "checkJs": false
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}
